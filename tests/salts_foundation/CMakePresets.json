{
  "version": 6,
  "configurePresets": [
    {
      "name": "foundation-release",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../build/${presetName}/vcpkg_installed"
      }
    }
  ]
}
